---
import Base from '../layouts/Base.astro';
import dmSansUrl from '../../../mobile/assets/fonts/DM Sans.ttf?url';
import crewBoardBackground from '../../../mobile/src/assets/crew-board-background.png';
import crewLogo from '../../../mobile/src/assets/crew-logo.png';
import boardReference from '../../../mobile/evidence/event-hub-option-2/reference-390x844.png';

const canonical = 'https://crew-haus.com/';
const description =
  'Crew Next wird für Golfreisen und Team-Events entwickelt. Ein mobiles Zuhause soll zeigen, was jetzt und als Nächstes zählt.';

const configuredContact = import.meta.env.PUBLIC_CLOSED_PREVIEW_CONTACT_URL;
let previewContactUrl: string | undefined;

if (configuredContact) {
  try {
    const target = new URL(configuredContact);
    if (target.protocol === 'https:' && !target.username && !target.password) {
      previewContactUrl = target.toString();
    }
  } catch {
    previewContactUrl = undefined;
  }
}

const fontFaceCss = `
  @font-face {
    font-family: 'DM Sans';
    src: url('${dmSansUrl}') format('truetype');
    font-display: swap;
    font-style: normal;
    font-weight: 100 900;
  }
`;
---

<Base
  title="Crew Next Closed Preview | Der gemeinsame Plan für eure Gruppe"
  description={description}
  canonical={canonical}
  favicon={crewLogo.src}
  lang="de-CH"
  robots="noindex, nofollow, noarchive"
>
  <link slot="head" rel="preload" href={dmSansUrl} as="font" type="font/ttf" crossorigin="anonymous" />
  <style slot="head" is:inline set:html={fontFaceCss}></style>

  <a class="skip-link" href="#hauptinhalt">Zum Hauptinhalt</a>

  <div class="preview-page" style={`--board-background: url('${crewBoardBackground.src}')`}>
    <header class="topbar" aria-label="Crew Next Closed Preview">
      <div class="brand" aria-label="Crew Next">
        <img src={crewLogo.src} width="192" height="192" alt="" />
        <span>CREW</span>
      </div>
      <p class="preview-chip">Closed Preview</p>
    </header>

    <main id="hauptinhalt" class="hero" tabindex="-1">
      <section class="hero-copy" aria-labelledby="preview-title">
        <p class="eyebrow">CREW NEXT · CLOSED PREVIEW</p>
        <h1 id="preview-title">Der gemeinsame Plan für eure Gruppe.</h1>
        <p class="lead">
          Crew Next wird für Golfreisen und Team-Events entwickelt. Ein mobiles
          Zuhause soll Organisator:innen und Teilnehmer:innen zeigen, was jetzt
          und als Nächstes zählt.
        </p>

        <div class="preview-action" id="preview-status">
          {
            previewContactUrl ? (
              <a class="cta" href={previewContactUrl}>Closed Preview anfragen</a>
            ) : (
              <button class="cta" type="button" disabled aria-describedby="contact-status">
                Closed Preview anfragen
              </button>
            )
          }
          {
            !previewContactUrl && (
              <p id="contact-status">
                Noch nicht öffentlich: Wir schalten den Kontaktweg erst nach der
                Datenschutzprüfung frei.
              </p>
            )
          }
        </div>
      </section>

      <figure class="board-preview">
        <div class="visual-label">Option 2 · Crew Board</div>
        <img
          src={boardReference.src}
          width="390"
          height="844"
          alt="Konzeptansicht des Crew Boards für eine Golfreise mit Tagesplan und nächster Aktion."
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          Konzeptbild · verbindliche Designrichtung · keine finale Produktansicht
        </figcaption>
      </figure>
    </main>

    <footer>
      <p>Crew Next · Closed Preview · nicht veröffentlicht</p>
    </footer>
  </div>
</Base>

<style>
  :global(body) {
    background: #f0ddf5;
  }

  .skip-link {
    position: fixed;
    z-index: 20;
    top: 12px;
    left: 12px;
    padding: 10px 14px;
    color: #2d2d2d;
    background: #ffffff;
    border: 3px solid #2d2d2d;
    border-radius: 12px;
    box-shadow: 3px 3px 0 #2d2d2d;
    font: 700 14px/1.2 'DM Sans', sans-serif;
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .preview-page {
    --canvas: #f0ddf5;
    --paper: #ffffff;
    --ink: #2d2d2d;
    --gold: #f5d565;
    --mint: #c2e8d5;
    --lavender: #d5c2e8;
    --purple: #685898;
    min-height: 100svh;
    padding: 18px clamp(16px, 4vw, 48px) 28px;
    color: var(--ink);
    background-color: var(--canvas);
    background-image: var(--board-background);
    background-position: center;
    background-size: cover;
    font-family: 'DM Sans', sans-serif;
  }

  .topbar,
  .hero,
  footer {
    width: min(1160px, 100%);
    margin-inline: auto;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -0.7px;
  }

  .brand img {
    width: 48px;
    height: 48px;
  }

  .preview-chip,
  .visual-label {
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .preview-chip {
    padding: 10px 14px;
    background: var(--paper);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(330px, 0.72fr);
    align-items: center;
    gap: clamp(48px, 8vw, 112px);
    padding-block: clamp(44px, 7vw, 92px);
  }

  .hero-copy {
    max-width: 660px;
  }

  .eyebrow {
    width: fit-content;
    margin-bottom: 24px;
    padding: 10px 14px;
    color: var(--purple);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  h1 {
    max-width: 650px;
    margin: 0;
    font-size: clamp(48px, 6.4vw, 82px);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .lead {
    max-width: 610px;
    margin-top: 28px;
    color: var(--purple);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 500;
    line-height: 1.48;
  }

  .preview-action {
    width: min(100%, 470px);
    margin-top: 36px;
  }

  .cta {
    display: inline-flex;
    width: 100%;
    min-height: 56px;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    color: var(--ink);
    background: var(--mint);
    border: 3px solid var(--ink);
    border-radius: 18px;
    box-shadow: 5px 5px 0 var(--ink);
    font: 800 17px/1.2 'DM Sans', sans-serif;
    text-align: center;
    text-decoration: none;
  }

  .cta:disabled {
    color: #4c4750;
    background: #d8d1dc;
    box-shadow: 2px 2px 0 var(--ink);
    cursor: not-allowed;
  }

  .cta:focus-visible,
  .skip-link:focus-visible {
    outline: 4px solid var(--purple);
    outline-offset: 4px;
  }

  .preview-action p {
    margin-top: 14px;
    color: #4c4750;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.45;
  }

  .board-preview {
    width: min(100%, 400px);
    margin: 0 auto;
    padding: 12px;
    background: var(--gold);
    border: 3px solid var(--ink);
    border-radius: 28px;
    box-shadow: 10px 10px 0 var(--ink);
  }

  .visual-label {
    width: fit-content;
    margin: 2px 2px 12px;
    padding: 9px 12px;
    background: var(--paper);
  }

  .board-preview img {
    display: block;
    width: 100%;
    height: auto;
    border: 3px solid var(--ink);
    border-radius: 20px;
    background: var(--canvas);
  }

  figcaption {
    margin: 14px 4px 2px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
  }

  footer {
    padding-top: 22px;
    border-top: 2px solid var(--ink);
    font-size: 13px;
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 52px;
    }

    .hero-copy {
      max-width: 700px;
    }

    .board-preview {
      width: min(92%, 390px);
    }
  }

  @media (max-width: 520px) {
    .preview-page {
      padding: 14px 16px 24px;
    }

    .topbar {
      min-height: 54px;
    }

    .brand {
      gap: 9px;
      font-size: 21px;
    }

    .brand img {
      width: 42px;
      height: 42px;
    }

    .preview-chip {
      padding: 8px 10px;
      font-size: 10px;
    }

    .hero {
      gap: 42px;
      padding-block: 42px 56px;
    }

    .eyebrow {
      margin-bottom: 20px;
      padding-inline: 11px;
      font-size: 10px;
    }

    h1 {
      font-size: clamp(43px, 13vw, 58px);
      letter-spacing: -0.05em;
    }

    .lead {
      margin-top: 22px;
      font-size: 18px;
    }

    .preview-action {
      margin-top: 30px;
    }

    .board-preview {
      width: calc(100% - 10px);
      padding: 9px;
      border-radius: 23px;
      box-shadow: 7px 7px 0 var(--ink);
    }

    .board-preview img {
      border-radius: 16px;
    }
  }

</style>
