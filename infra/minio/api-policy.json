{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Effect": "Allow",
			"Action": ["s3:GetBucketLocation"],
			"Resource": ["arn:aws:s3:::crew-event-development"]
		},
		{
			"Effect": "Allow",
			"Action": ["s3:PutObject"],
			"Resource": ["arn:aws:s3:::crew-event-development/quarantine/*"]
		},
		{
			"Effect": "Allow",
			"Action": ["s3:GetObject"],
			"Resource": ["arn:aws:s3:::crew-event-development/committed/*"]
		}
	]
}
