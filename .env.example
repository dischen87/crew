# Local development only. Copy to .env and replace every value before sharing a host.
POSTGRES_ADMIN_PASSWORD=crew-local-postgres-admin-change-2026
USER_DB_OWNER_PASSWORD=crew-local-user-owner-change-2026
USER_DB_API_PASSWORD=crew-local-user-api-change-2026
USER_DB_MAGIC_WORKER_PASSWORD=crew-local-user-magic-change-2026
USER_DB_PUSH_WORKER_PASSWORD=crew-local-user-push-change-2026
EVENT_DB_OWNER_PASSWORD=crew-local-event-owner-change-2026
EVENT_DB_API_PASSWORD=crew-local-event-api-change-2026
EVENT_DB_ATTACHMENT_WORKER_PASSWORD=crew-local-event-attachment-change-2026
EVENT_DB_NOTIFICATION_WORKER_PASSWORD=crew-local-event-notification-change-2026
EVENT_DB_RECAP_RETENTION_WORKER_PASSWORD=crew-local-event-recap-retention-change-2026

MINIO_ROOT_USER=crewlocaladmin
MINIO_ROOT_PASSWORD=crew-local-minio-admin-change-2026
MINIO_API_ACCESS_KEY=crewlocalapi
MINIO_API_SECRET_KEY=crew-local-minio-api-change-2026
MINIO_WORKER_ACCESS_KEY=crewlocalattachment
MINIO_WORKER_SECRET_KEY=crew-local-minio-worker-change-2026
TYPESENSE_API_KEY=crew-local-typesense-key-change-2026
# Local Compose uses the master value for convenience. Provision a search-only
# documents:search key for PLACE_SEARCH_TYPESENSE_SEARCH_API_KEY outside local dev.
TYPESENSE_SEARCH_API_KEY=crew-local-typesense-key-change-2026
PROVIDER_SINK_BEARER=crew-local-provider-bearer-change-2026
PROVIDER_SINK_FIXTURE_BEARER=crew-local-fixture-bearer-change-2026

REDIS_GATEWAY_PASSWORD=crew_local_gateway_redis_change_2026
REDIS_USER_PASSWORD=crew_local_user_redis_change_2026
GATEWAY_RATE_LIMIT_KEY=BAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAg
USER_RATE_LIMIT_KEY=DAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAg

REFRESH_TOKEN_KEY=crew-local-refresh-token-key-change-2026
INVITATION_TOKEN_KEY=crew-local-invitation-token-key-change-2026
RECAP_SHARE_TOKEN_CURRENT_KEY_ID=local-recap-share-v1
RECAP_SHARE_TOKEN_CURRENT_KEY=crew-local-recap-share-token-key-change-2026
# Rotation overlap only: set all three, retain for at most seven days, then unset.
RECAP_SHARE_TOKEN_PREVIOUS_KEY_ID=
RECAP_SHARE_TOKEN_PREVIOUS_KEY=
RECAP_SHARE_TOKEN_PREVIOUS_NOT_AFTER=
# Caption text grants stay server-disabled until Legal/Privacy approval.
# Development and Compose-local caption keys are accepted only while this gate is
# false. Before enabling it in production, provision distinct random current and
# optional previous keys (minimum 32 bytes) outside this file.
RECAP_EXTERNAL_CAPTIONS_ENABLED=false
RECAP_CAPTION_FIELD_REF_CURRENT_KEY=crew-local-recap-caption-field-ref-key-change-2026
RECAP_CAPTION_FIELD_REF_PREVIOUS_KEY=
SYNC_CURSOR_KEY=crew-local-sync-cursor-key-change-2026
PLACE_SEARCH_CURSOR_KEY=crew-local-place-search-cursor-key-change-2026
ATTACHMENT_GRANT_KEY=crew-local-attachment-grant-key-change-2026
DELIVERY_PAYLOAD_CURRENT_KEY=eKOfuEuHFGQeOZltcgU4hlzp3jYpRNrp3xvjzwjJkSE
PUSH_PAYLOAD_CURRENT_KEY=TxsYmFtlYMVPT1UZKmSGicjfoc8lhZ0kGQ3FgIZavhs
EVENT_NOTIFICATION_PAYLOAD_CURRENT_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
EVENT_NOTIFICATION_SERVICE_CURRENT_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
MEMBER_DIRECTORY_SERVICE_CURRENT_KEY=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI
# Optional during a bounded member-directory service-auth rotation window.
MEMBER_DIRECTORY_SERVICE_PREVIOUS_KEY_ID=
MEMBER_DIRECTORY_SERVICE_PREVIOUS_KEY=
PLACE_CANDIDATE_SERVICE_CURRENT_KEY=CAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAg

# Non-secret golf-candidate tile. The Compose defaults cover Belek; replace
# these four values to import another worldwide OpenStreetMap tile.
PLACE_GOLF_IMPORT_BOUNDS=36.78,30.90,36.95,31.30
PLACE_GOLF_IMPORT_COUNTRY_CODE=TR
PLACE_GOLF_IMPORT_LOCALITY=Belek
PLACE_GOLF_IMPORT_REGION=Antalya

# Non-secret policy label shared by the request API and enrichment worker.
# Provider URLs and credentials belong only to the worker runtime.
EVENT_ENRICHMENT_LLM_MODEL=local-fixture-model

# Optional JWKS overlap slot: prepublish the next public key, then retain the old key through access-token TTL plus verifier cache.
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY_PATH=

GATEWAY_HOST_PORT=3000
USER_API_HOST_PORT=3001
EVENT_API_HOST_PORT=3002
POSTGRES_HOST_PORT=5433
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
TYPESENSE_HOST_PORT=8108
REDIS_HOST_PORT=6380
