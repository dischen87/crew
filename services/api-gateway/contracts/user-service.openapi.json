      "patch": {
        "operationId": "usersMeUpdate",
        "tags": [
          "users"
        ],
        "summary": "Update the authenticated user's profile",
        "security": [
          {
            "userBearer": []
          }
        ],
        "x-idempotency": "required",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
              "example": "01J4Z3YQ4N6K8T2V5X7C9M1P3R"
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "baseVersion": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "changes": {
                    "type": "object",
                    "properties": {
                      "displayName": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "avatarUrl": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "uri"
                      },
                      "locale": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 35
                      },
                      "timeZone": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "reduceMotion": {
                        "type": "boolean"
                      },
                      "eventReminders": {
                        "type": "boolean"
                      },
                      "productUpdates": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "baseVersion",
                  "changes"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "headers": {
              "X-Request-ID": {
                "description": "Crew request correlation identifier",
                "schema": {
                  "type": "string"
