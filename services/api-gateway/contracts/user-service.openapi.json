    "/v1/member-directory-profiles/resolve": {
      "post": {
        "operationId": "usersMemberDirectoryProfilesResolve",
        "tags": [
          "internal"
        ],
        "summary": "Resolve a bounded active-member page to public display fields",
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "x-gateway-compose-only": true,
        "x-idempotency": "natural",
        "x-max-decoded-body-bytes": 16384,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "type": "number",
                    "enum": [
                      1
                    ]
                  },
                  "rootEventId": {
                    "type": "string",
                    "pattern": "^evt_[A-Za-z0-9._:-]{1,96}$"
                  },
                  "userIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^usr_[a-f0-9]{32}$"
                    },
                    "minItems": 1,
                    "maxItems": 200
                  }
                },
                "required": [
                  "schemaVersion",
                  "rootEventId",
                  "userIds"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exact ordered profile set",
            "headers": {
              "X-Request-ID": {
                "description": "Crew request correlation identifier",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotency-Replayed": {
                "description": "Present with value true when a completed response is replayed",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                }
              },
              "Cache-Control": {
                "description": "Prevents storage of credential and private-profile responses",
                "schema": {
                  "type": "string",
                  "enum": [
                    "private, no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schemaVersion": {
                      "type": "number",
                      "enum": [
                        1
                      ]
                    },
                    "rootEventId": {
                      "type": "string",
                      "pattern": "^evt_[A-Za-z0-9._:-]{1,96}$"
                    },
                    "profiles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MemberDirectoryProfile"
                      },
                      "maxItems": 200
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "rootEventId",
                    "profiles"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "headers": {
              "X-Request-ID": {
                "description": "Crew request correlation identifier",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Service authentication required",
            "headers": {
              "X-Request-ID": {
                "description": "Crew request correlation identifier",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Profile set incomplete",
            "headers": {
              "X-Request-ID": {
                "description": "Crew request correlation identifier",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
