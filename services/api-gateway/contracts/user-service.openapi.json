              "X-Request-ID": {
                "description": "Crew request correlation identifier",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "headers": {
              "X-Request-ID": {
                "description": "Crew request correlation identifier",
                "schema": {
                  "type": "string"
                }
